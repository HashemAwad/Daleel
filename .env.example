# Copy to .env and fill in. Never commit .env.
# --- Model ---  (full guide: docs/LLM.md)
# Two paths. HOSTED works now; SELFHOST is preferred when installed and uses
# the hosted settings below automatically if the local model fails.
#
# A) HOSTED (fluent now): Gemini is the quality-first demo choice
DALEEL_MODEL_PROVIDER=hosted            # hosted | selfhost | anthropic
DALEEL_HOSTED_MODEL=gemini-3.6-flash
DALEEL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DALEEL_LLM_API_KEY=                     # paste the Gemini key; never commit .env
#
# B) SELFHOST for this demo (private; hosted remains automatic backup) — finish
# `ollama pull qwen2.5:7b`, then set provider=selfhost. Hosted remains fallback.
DALEEL_LOCAL_MODEL=qwen2.5:7b
# Qwen3 8B is a post-demo upgrade candidate, not a blocker today.
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=                      # unused (paid path)

# --- Database (docker-compose brings this up) ---
DATABASE_URL=postgresql://daleel:daleel@localhost:5432/daleel

# --- Channels ---
# All four come from the Twilio console: Messaging > Try it out > WhatsApp.
# The sandbox number is per-account -- do NOT assume the old +1415 shared one.
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=                           # AC... ; auth for voice-note media downloads
TWILIO_WHATSAPP_FROM=whatsapp:+1 737 250 8034    # YOUR sandbox number, shown on that page
TWILIO_SANDBOX_JOIN_CODE=                     # the "join <code>" phrase; fills the /join QR
PUBLIC_BASE_URL=                              # tunnel/VM https URL -- must match the webhook
                                              # URL in the console exactly, or every request 403s
REQUIRE_TWILIO_SIGNATURE=false                # true wherever the webhook is publicly reachable

# --- Privacy / retention ---
RETENTION_IDLE_MINUTES=30     # set to 2 for the live demo so judges can watch deletion
SESSION_HASH_SALT=change-me     # MUST be changed: with this default no transcript rows are stored
STORE_TRANSCRIPT_TEXT=0          # 1 = keep scrubbed text until retention deletes it (demo)
RETENTION_INTERVAL_SECONDS=600   # how often `python -m data.retention --loop` sweeps (demo: 20)

# --- Speech-to-text (voice notes) ---
STT_PROVIDER=whisper          # whisper | hosted ; see docs/tickets/dev-b.md
STT_API_KEY=
# Local Whisper (audio never leaves the machine). Try a file: PYTHONPATH=src python -m ai.transcribe clip.ogg --answer
WHISPER_MODEL=small           # small | medium | large-v3 ; time one clip on the demo machine before going bigger
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8
WHISPER_MAX_SECONDS=60        # only the first minute of a long voice note is transcribed
# WHISPER_HINTS=              # words Whisper should expect; replaces the built-in list in src/ai/transcribe.py
WEBHOOK_BUDGET_SECONDS=12     # Twilio drops a webhook at ~15 s; past this we reply at once and send the answer by REST

# --- Environment ---
DALEEL_ENV=dev                   # the demo server sets "production", which makes the test suite refuse to run
