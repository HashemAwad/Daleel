# Copy to .env and fill in. Never commit .env.
# --- Model (demo) ---
ANTHROPIC_API_KEY=
DALEEL_MODEL=claude-sonnet-4-6          # workhorse; use claude-haiku-4-5 for speed/cost
DALEEL_MODEL_PROVIDER=anthropic         # anthropic | selfhost (toggle for Phase-1 stretch)

# --- Database (docker-compose brings this up) ---
DATABASE_URL=postgresql://daleel:daleel@localhost:5432/daleel

# --- Channels ---
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox number
PUBLIC_BASE_URL=                              # ngrok / VM https URL for the webhook

# --- Privacy / retention ---
RETENTION_IDLE_MINUTES=30     # set to 2 for the live demo so judges can watch deletion
SESSION_HASH_SALT=change-me

# --- Speech-to-text (voice notes) ---
STT_PROVIDER=whisper          # whisper | hosted ; see docs/tickets/dev-b.md
STT_API_KEY=
